# ===================================
# Chatbot Configuration
# ===================================

# OpenAI API Configuration (ถ้าใช้ OpenAI)
# OPENAI_API_KEY=sk-your-api-key-here
# OPENAI_ORGANIZATION_ID=org-your-org-id

# Google Gemini API Configuration (ถ้าใช้ Google Gemini)
# GEMINI_API_KEY=your-gemini-api-key
# GEMINI_MODEL=gemini-pro

# Chatbot Default Settings
CHATBOT_DEFAULT_TITLE="Chat Assistant"
CHATBOT_DEFAULT_EMPTY_MESSAGE="สวัสดี! ฉันพร้อมช่วยคุณ"
CHATBOT_DEFAULT_PLACEHOLDER="พิมพ์ข้อความของคุณ..."

# Rate Limiting
CHATBOT_RATE_LIMIT=100  # requests per minute
CHATBOT_RATE_WINDOW=1   # minutes

# Session Configuration
CHATBOT_SESSION_TIMEOUT=1440  # minutes (24 hours)

# Database (สำหรับเก็บ chat history)
# CHATBOT_STORE_HISTORY=true
# CHATBOT_HISTORY_TABLE=chat_histories

# Features
CHATBOT_ENABLE_TYPING_INDICATOR=true
CHATBOT_ENABLE_TIMESTAMPS=true
CHATBOT_ENABLE_CLEAR_HISTORY=true
CHATBOT_ENABLE_EXPORT=false

# Logging
CHATBOT_LOG_MESSAGES=false
CHATBOT_LOG_FILE=storage/logs/chatbot.log
